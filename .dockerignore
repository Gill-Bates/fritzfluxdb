# =============================================================================
# fritzFluxDB - Docker build context excludes
# =============================================================================
# The image only needs: pyproject.toml, README.md, run.py, BUILD_INFO*, app/
# and docker/entrypoint.sh (see docker/Dockerfile). Everything else is
# excluded to keep the build context small and to avoid leaking secrets
# (.env) into it.
# =============================================================================

# --- Secrets / local runtime config (must NEVER enter the build context) ---
.env
.env.*
*.env

# --- Version control & CI ---------------------------------------------------
.git
.gitignore
.gitattributes
.github/
.claude/
.kiro/
.omc/
.omx/

# --- Python caches / virtualenvs / build artifacts -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
full_codebase*
my-fritzfluxdb.xml
.ruff_cache/

# --- Not needed inside the image (Dockerfile only COPYs run.py, BUILD_INFO*,
# app/ and docker/entrypoint.sh) --------------------------------------
tests/
tools/

# --- Docker files not needed inside the image ------------------------------
# (docker/entrypoint.sh IS copied by the Dockerfile, so it is NOT ignored)
.dockerignore
docker/Dockerfile
docker/docker-compose*.yml
docker/build.sh

# --- Project assets unrelated to the runtime -------------------------------
grafana/
*.xml
*.md
!README.md
LICENSE
setup.conf
# NOTE: BUILD_INFO is intentionally NOT ignored - it is copied into the image
# so the startup banner / version.py can read version, git sha and build date.
# NOTE: pyproject.toml is intentionally NOT ignored - it is the single source
# of truth for the version and the dependency list (see docker/Dockerfile).

# --- Editors / OS cruft -----------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- Logs / temp / backups --------------------------------------------------
*.log
*.tmp
*.backup
