# fritzFlux - QuestDB Open Source settings
# Combine with .env.example to create .env.

DB_TYPE=questdb
QUESTDB_HOSTNAME="<your-questdb-hostname>"
QUESTDB_PORT=9000
# QUESTDB_TLS_ENABLED=False
# QUESTDB_VERIFY_TLS=True
# QUESTDB_MEASUREMENT_NAME="fritzbox"

# Total days of data to keep. Existing administrator-managed TTLs are never overwritten.
# QUESTDB_DATA_RETENTION_DAYS=365

# Optional server-side downsampling: low, medium or high.
# Unset/empty disables downsampling. Raw polling and ingestion stay unchanged.
# low: 30d raw + 1m rollup; medium: 7d raw + 1m rollup; high: 1d raw + 5m rollup.
# QUESTDB_DOWNSAMPLING=medium

# Optional HTTP basic authentication. Configure matching credentials on the
# QuestDB server with QDB_HTTP_USER and QDB_HTTP_PASSWORD.
# QUESTDB_USERNAME="<questdb-username>"
# QUESTDB_PASSWORD="<questdb-password>"

# Allow sending credentials over plain HTTP (trusted home networks only).
# QUESTDB_ALLOW_PLAINTEXT_CREDENTIALS=True
